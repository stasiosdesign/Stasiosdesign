# The website's environment variables. Never commit real values: locally they
# go in a git-ignored .env; on Vercel in Project → Settings → Environment
# Variables, scoped as noted. Which deployment a build is for comes from
# Vercel itself (VERCEL_ENV), not from a variable here: see astro.config.mjs.

# Where the Let's Talk form posts. Any backend that accepts a POST works
# (Formspree, Basin, Formcarry, Getform, your own handler...). Left unset, the
# form falls back to opening the visitor's email client with the answers
# prefilled. Vercel: Production (and Preview).
PUBLIC_FORM_ENDPOINT=

# The publishing route (api/publish.ts, a Vercel Function on the production
# deployment), which the Studio's publishing control calls. SECRET, server-side
# only. Vercel: Production.
# A Sanity API token with the Editor role, for project 9k36yeeg: the route
# writes both datasets with it on the Studio's behalf.
SANITY_API_WRITE_TOKEN=
# The deploy hook for `main` (Project → Settings → Git → Deploy Hooks): the
# route calls it after every live publish, unpublish or delete, so the static
# live site is rebuilt from the production dataset.
VERCEL_DEPLOY_HOOK_URL=
# The deploy hook for `staging`: the route calls it after every staging write,
# so the static staging site is rebuilt from the staging dataset.
VERCEL_STAGING_DEPLOY_HOOK_URL=

# Optional, public: build against another dataset. The dataset otherwise
# follows the deployment: production on main, staging everywhere else.
# PUBLIC_SANITY_DATASET=production
