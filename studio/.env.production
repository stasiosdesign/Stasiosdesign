# Settings for the hosted Studio (sanity build / npm run deploy). Public: every
# SANITY_STUDIO_ value is compiled into the Studio, so never put a secret here.

# The site the Visual editor shows. The site has no staging deployment yet,
# so it is the live site, as anyone sees it (no draft mode).
SANITY_STUDIO_PREVIEW_ORIGIN=https://www.stasiosdesign.com

# The live site, for the publishing menu's links
SANITY_STUDIO_PRODUCTION_ORIGIN=https://www.stasiosdesign.com
