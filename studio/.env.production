# Settings for the hosted Studio (sanity build / npm run deploy). Public: every
# SANITY_STUDIO_ value is compiled into the Studio, so never put a secret here.

# The site the Visual editor shows: this repository's build on Vercel. The
# public domain (www.stasiosdesign.com) is served elsewhere and refuses to be
# shown inside another site (frame-ancestors 'self'), so the Visual editor
# can't use it. The Studio writes your unpublished drafts into it live.
SANITY_STUDIO_PREVIEW_ORIGIN=https://stasiosdesign.vercel.app

# The live site (this repository's Vercel build, until the public domain moves to
# it): the publishing menu's links and the build stamp (/build.json)
SANITY_STUDIO_PRODUCTION_ORIGIN=https://stasiosdesign.vercel.app
