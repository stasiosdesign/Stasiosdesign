# Settings for `npm run dev` (sanity dev). Public: every SANITY_STUDIO_ value
# is compiled into the Studio, so never put a secret here. Override one on
# your machine only in .env.development.local (git-ignored).

# The site the Visual editor shows: your own dev server (npm run dev at the
# repository root, port 4321).
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:4321

# The live site (this repository's Vercel build, until the public domain moves to
# it): the publishing menu's links and the build stamp (/build.json)
SANITY_STUDIO_PRODUCTION_ORIGIN=https://stasiosdesign.vercel.app
