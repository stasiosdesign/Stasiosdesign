---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getDocument, reader } from '../cms/content';
import * as D from '../cms/defaults';

const { t } = reader(await getDocument('aboutPage'), D.aboutPage);
---

<Layout
  title="Untitled"
  pageId="67abba7f95eab0b5c1f1d0f6"
  bodyClass="body-10"
  containerClass="body-container"
  doc={{ id: 'aboutPage' }}
>
  <section class="section">
    <div class="nav-black">
      <a href="/" class="nav-text-home-black">HOME</a>
      <a href="/work" class="nav-text-work-black">WORK</a>
      <a href="/work" class="nav-text-about-black">ABOUT</a>
      <a href="/lets-talk" class="nav-text-chat-black">TALK</a>
      <div class="nav-code-black w-embed">
        
      </div>
    </div>
    <div class="div-block-211">
      <div class="div-block-210"></div>
      <div class="text-block-85" data-page-field="hero.heading">{t('hero.heading')}</div>
    </div>
  </section>
  <Footer />
</Layout>
