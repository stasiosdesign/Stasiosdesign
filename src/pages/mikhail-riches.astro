---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getDocument, pageDoc, reader } from '../cms/content';
import * as D from '../cms/defaults';

// The page's words are its case study's (studio/schemaTypes/documents/case-study.ts), and the next
// project's name that one's title, each element falling back to its own (src/cms/defaults.ts)
const c = reader(await getDocument(D.mikhailRiches._id), D.mikhailRiches);
const next = reader(await getDocument(D.architecturalWorks._id), D.architecturalWorks);

// The same page is also published at /mikhail-riches-copy, under another Webflow page id.
const { pageId = '67f443f41da89e176a75b306' } = Astro.props;
---

<Layout
  title="Work: Mikhail Riches"
  pageId={pageId}
  bodyClass="body-2"
  containerClass="body-container"
  doc={{ id: D.mikhailRiches._id, type: 'caseStudy' }}
  viewLabel="[View Next Project]"
>
  <section class="w1-section-hero">
    <div class="w1-container-hero">
      <div class="nav-black">
        <a href="/" class="nav-text-home-black">HOME</a>
        <a href="/work" class="nav-text-work-black">WORK</a>
        <a href="/work" class="nav-text-about-black">ABOUT</a>
        <a href="/lets-talk" class="nav-text-chat-black">TALK</a>
        <div class="nav-code-black w-embed">
          
        </div>
      </div>
      <div class="casestudy_hero_text_container">
        <div class="w1-title-wrapper">
          <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="casestudsy_hero_heading" data-page-field="title">{c.t('title')}</div>
        </div>
        <div class="w1-sub_heading-wrapper">
          <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="casestudy_subheading_container">
            <div class="casestudy_hero_subheading" data-page-field="service">{c.t('service')}</div>
            <div class="spacer_vertical"></div>
            <div class="casestudy_hero_subheading" data-page-field="sector">{c.t('sector')}</div>
            <div class="spacer_vertical"></div>
            <div class="casestudy_hero_subheading" data-page-field="year">{c.t('year')}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="w1-stick_wrapper">
    <div class="stick_trigger">
      <div class="stick_track">
        <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="stick_element"><img src="/assets/images/MK-work-section_1.avif" loading="lazy" sizes="(max-width: 5107px) 100vw, 5107px" alt="" srcset="/assets/images/MK-work-section_1MK-work-section.avif 2600w, /assets/images/MK-work-section_1.avif 5107w" class="image-2 mk"><img src="/assets/images/MK-Iphone_1.avif" loading="eager" fetchpriority="high" sizes="(max-width: 2853px) 100vw, 2853px" alt="" srcset="/assets/images/MK-Iphone_1MK-Iphone.avif 1080w, /assets/images/MK-Iphone_1.avif 2853w" class="image-2 mk tablet"></div>
      </div>
    </div>
  </div>
  <section data-w-id="ec7c3d2f-52c3-0f43-fb18-93230677fc68" class="w1-section-intro_text mk">
    <div class="container-project-summary">
      <div class="problem-container befor">
        <div class="title problem">Problem<br></div>
        <div class="list problem" data-page-field="problems.0">{c.t('problems.0')}<br></div>
        <div class="list problem" data-page-field="problems.1">{c.t('problems.1')}<br></div>
        <div class="list problem" data-page-field="problems.2">{c.t('problems.2')}<br></div>
        <div class="list problem" data-page-field="problems.3">{c.t('problems.3')}<br></div>
      </div>
      <div class="problem-container after">
        <div class="title" data-page-field="outcomesLabel">{c.t('outcomesLabel')}<br></div>
        <div class="list solution" data-page-field="outcomes.0">{c.t('outcomes.0')}<br></div>
        <div class="list solution" data-page-field="outcomes.1">{c.t('outcomes.1')}<br></div>
        <div class="list solution" data-page-field="outcomes.2">{c.t('outcomes.2')}<br></div>
        <div class="list solution" data-page-field="outcomes.3">{c.t('outcomes.3')}<br></div>
      </div>
    </div>
    <div class="container-project-intro">
      <div text-split="" scrub-each-word-slower="" class="into-project-subheading" data-page-field="headline">{c.t('headline')}</div>
    </div>
  </section>
  <section class="csj-2x-desktop mk">
    <div class="csj-desktop _3 mk"></div>
    <div class="csj-desktop mk"></div>
    <div class="csj-desktop _2 mk"></div>
  </section>
  <section data-w-id="3ecc76dd-eb95-4ca2-1312-9b57c1ecbe2b" class="csj-2x-mobile">
    <div class="csj-mobile _1">
      <div class="mobile-window l mk-architects"></div>
    </div>
    <div class="csj-mobile _2">
      <div class="mobile-window mk-architects"></div>
    </div>
    <div class="csj-mobile _3">
      <div class="mobile-window r mk-architects"></div>
    </div>
  </section>
  <section class="section-next_project">
    <div class="sticky-container-next_project">
      <div data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691214" class="container-next_project">
        <div class="div-block-218">
          <div class="nex_ip-next-up">Next</div>
          <div data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691218" class="next_up-prohect_name" {...pageDoc(D.architecturalWorks._id, 'caseStudy')} data-page-field="title">{next.t('title')}</div>
        </div>
        <div class="div-block-217">
          <a cursor-viewproject="" data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e69121b" href="/work-architectural-works" class="next_project-case_image w-inline-block"><img src="/assets/images/TOD-Isometric-next-project-1_1.avif" loading="lazy" alt="" srcset="/assets/images/TOD-Isometric-next-project-1_1TOD-Isometric-next-project-1.avif 500w, /assets/images/TOD-Isometric-next-project-1_1.avif 892w" sizes="(max-width: 892px) 100vw, 892px" class="image-3"></a>
          <div class="next-up-line"></div>
        </div>
      </div>
    </div>
  </section>
  <Footer contactFirst quoteHref="mailto:stas@stasiosdesign.com" />
</Layout>

{/* Webflow interaction pre-states for this page's elements, applied until IX2 takes over. */}
<style is:global>
@media (min-width:992px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e69121b"] {-webkit-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);}html.w-mod-js:not(.w-mod-ix) [data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691218"] {opacity:1;}}
</style>
