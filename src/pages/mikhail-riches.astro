---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

// The same page is also published at /mikhail-riches-copy, under another Webflow page id.
const { pageId = '67f443f41da89e176a75b306' } = Astro.props;
---

<Layout
  title="Work: Mikhail Riches"
  pageId={pageId}
  bodyClass="body-2"
  containerClass="body-container"
  viewLabel="[View Next Project]"
>
  <section class="w1-section-hero">
    <div class="w1-container-hero">
      <div class="nav-black">
        <a href="/" class="nav-text-home-black">HOME</a>
        <a href="/work" class="nav-text-work-black">WORK</a>
        <a href="/work" class="nav-text-about-black">ABOUT</a>
        <a href="/lets-talk" class="nav-text-chat-black">TALK</a>
        <div class="nav-code-black w-embed">
          
        </div>
      </div>
      <div class="casestudy_hero_text_container">
        <div class="w1-title-wrapper">
          <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="casestudsy_hero_heading">Mikhail Riches</div>
        </div>
        <div class="w1-sub_heading-wrapper">
          <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="casestudy_subheading_container">
            <div class="casestudy_hero_subheading">Website Design</div>
            <div class="spacer_vertical"></div>
            <div class="casestudy_hero_subheading">Architecture Firm</div>
            <div class="spacer_vertical"></div>
            <div class="casestudy_hero_subheading">2025</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="w1-stick_wrapper">
    <div class="stick_trigger">
      <div class="stick_track">
        <div style="-webkit-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="stick_element"><img src="/images/MK-work-section_1.avif" loading="lazy" sizes="(max-width: 5107px) 100vw, 5107px" alt="" srcset="/images/MK-work-section_1MK-work-section.avif 2600w, /images/MK-work-section_1.avif 5107w" class="image-2 mk"><img src="/images/MK-Iphone_1.avif" loading="eager" fetchpriority="high" sizes="(max-width: 2853px) 100vw, 2853px" alt="" srcset="/images/MK-Iphone_1MK-Iphone.avif 1080w, /images/MK-Iphone_1.avif 2853w" class="image-2 mk tablet"></div>
      </div>
    </div>
  </div>
  <section data-w-id="ec7c3d2f-52c3-0f43-fb18-93230677fc68" class="w1-section-intro_text mk">
    <div class="container-project-summary">
      <div class="problem-container befor">
        <div class="title problem">Problem<br></div>
        <div class="list problem">&#x27;Template Site&#x27;<br></div>
        <div class="list problem">Unfocused<br></div>
        <div class="list problem">Unbranded<br></div>
        <div class="list problem">Poor UX<br></div>
      </div>
      <div class="problem-container after">
        <div class="title">Key Outcomes<br></div>
        <div class="list solution">Clarity<br></div>
        <div class="list solution">Brand Alignment<br></div>
        <div class="list solution">User Journey<br></div>
        <div class="list solution">Heirachy<br></div>
      </div>
    </div>
    <div class="container-project-intro">
      <div text-split="" scrub-each-word-slower="" class="into-project-subheading">Refining a digital presence to reflect sustainability and environmental design</div>
    </div>
  </section>
  <section class="csj-2x-desktop mk">
    <div class="csj-desktop _3 mk"></div>
    <div class="csj-desktop mk"></div>
    <div class="csj-desktop _2 mk"></div>
  </section>
  <section data-w-id="3ecc76dd-eb95-4ca2-1312-9b57c1ecbe2b" class="csj-2x-mobile">
    <div class="csj-mobile _1">
      <div class="mobile-window l mk-architects"></div>
    </div>
    <div class="csj-mobile _2">
      <div class="mobile-window mk-architects"></div>
    </div>
    <div class="csj-mobile _3">
      <div class="mobile-window r mk-architects"></div>
    </div>
  </section>
  <section class="section-next_project">
    <div class="sticky-container-next_project">
      <div data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691214" class="container-next_project">
        <div class="div-block-218">
          <div class="nex_ip-next-up">Next</div>
          <div data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691218" class="next_up-prohect_name">Architectural Works</div>
        </div>
        <div class="div-block-217">
          <a cursor-viewproject="" data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e69121b" href="/work-architectural-works" class="next_project-case_image w-inline-block"><img src="/images/TOD-Isometric-next-project-1_1.avif" loading="lazy" alt="" srcset="/images/TOD-Isometric-next-project-1_1TOD-Isometric-next-project-1.avif 500w, /images/TOD-Isometric-next-project-1_1.avif 892w" sizes="(max-width: 892px) 100vw, 892px" class="image-3"></a>
          <div class="next-up-line"></div>
        </div>
      </div>
    </div>
  </section>
  <Footer contactFirst quoteHref="mailto:stas@stasiosdesign.com" />
</Layout>

{/* Webflow interaction pre-states for this page's elements, applied until IX2 takes over. */}
<style is:global>
@media (min-width:992px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e69121b"] {-webkit-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0px, 61%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);}html.w-mod-js:not(.w-mod-ix) [data-w-id="53ea9d6c-5228-9044-6fef-ce6b7e691218"] {opacity:1;}}
</style>
