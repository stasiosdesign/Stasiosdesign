---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getDocument, pageDoc, reader } from '../cms/content';
import * as D from '../cms/defaults';

// The heading is the Work page document's; each row in the list is its case study's (List name,
// List year), each element falling back to its own words (src/cms/defaults.ts)
const { t } = reader(await getDocument('workPage'), D.workPage);
const mk = reader(await getDocument(D.mikhailRiches._id), D.mikhailRiches);
const csj = reader(await getDocument(D.csjArchitects._id), D.csjArchitects);
const arch = reader(await getDocument(D.architecturalWorks._id), D.architecturalWorks);
---

<Layout
  title="Work"
  pageId="65df193093f48b20c5d50403"
  bodyClass="body-9"
  containerClass="body-container"
  viewLabel="[View Project]"
  viewLabelClass="paragraph"
  startLabel="[Start Your Project]"
  doc={{ id: 'workPage' }}
>
  <section class="work-section">
    <div class="nav-black">
      <a href="/" class="nav-text-home-black">HOME</a>
      <a href="/work" aria-current="page" class="nav-text-work-black w--current">WORK</a>
      <a href="/work" aria-current="page" class="nav-text-about-black w--current">ABOUT</a>
      <a href="/lets-talk" class="nav-text-chat-black">TALK</a>
      <div class="nav-code-black w-embed">
        
      </div>
    </div>
    <div class="heading-work">
      <div class="work-my" data-page-field="hero.line1">{t('hero.line1')}</div>
      <div class="work-worktesxt" data-page-field="hero.line2">{t('hero.line2')}</div>
    </div>
    <div id="w-node-_6e2d9d3e-830c-36f2-5ffa-9ee109a22e74-c5d50403" class="w-layout-layout quick-stack-12 wf-layout-layout">
      <div class="w-layout-cell cell">
        <a href="https://archi-tech.network/" target="_blank" class="work-project atn w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
      <div class="w-layout-cell">
        <a href="https://hawkstone-developments.co.uk/" target="_blank" class="work-project atn0summit w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
      <div class="w-layout-cell">
        <a href="https://www.atn-summit.com/" target="_blank" class="work-project the-atn-summit w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
      <div class="w-layout-cell epitessers-hide-tbalet">
        <a data-w-id="1d516367-6f70-6d56-2606-d987c44b5568" href="https://epitessera.com" target="_blank" class="work-project epitessera w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
      <div class="w-layout-cell">
        <a href="/mikhail-riches" class="work-project mk w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
      <div class="w-layout-cell">
        <a href="/work-csj-architects" class="work-project csj w-inline-block">
          <div cursor-viewproject="" class="div-block-249"></div>
        </a>
      </div>
    </div>
    <div class="work-full-container">
      <section class="case-study-container">
        <div class="work-case-study _1" {...pageDoc(D.mikhailRiches._id, 'caseStudy')}>
          <div class="work-case-study-text-container">
            <div class="text-block-76" data-page-field="listTitle">{mk.t('listTitle')}</div>
            <div class="text-block-76" data-page-field="listYear">{mk.t('listYear')}</div>
          </div>
        </div>
        <div class="work-case-study _2" {...pageDoc(D.csjArchitects._id, 'caseStudy')}>
          <div class="work-case-study-text-container">
            <div class="text-block-76" data-page-field="listTitle">{csj.t('listTitle')}</div>
            <div class="text-block-76" data-page-field="listYear">{csj.t('listYear')}</div>
          </div>
        </div>
      </section>
      <section class="case-study-container">
        <a href="/work-architectural-works" class="work-case-study _3 w-inline-block" {...pageDoc(D.architecturalWorks._id, 'caseStudy')}>
          <div class="work-case-study-text-container">
            <div class="text-block-76" data-page-field="listTitle">{arch.t('listTitle')}</div>
            <div class="text-block-76" data-page-field="listYear">{arch.t('listYear')}</div>
          </div>
        </a>
        <div class="work-case-study _4"></div>
      </section>
    </div>
  </section>
  <Footer contactFirst socialsClass="socials" />
</Layout>
